@page
@model SRAUMOAR.Pages.facturas.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Factura</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.JsonDte)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.JsonDte)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.Anulada)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.Anulada)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.SelloRecepcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.SelloRecepcion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.JsonAnulacion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.JsonAnulacion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.SelloAnulacion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.SelloAnulacion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.Fecha)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.Fecha)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.CodigoGeneracion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.CodigoGeneracion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.NumeroControl)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.NumeroControl)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.TipoDTE)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.TipoDTE)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.TotalGravado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.TotalGravado)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.TotalExento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.TotalExento)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.TotalPagar)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.TotalPagar)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Factura.TotalIva)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Factura.TotalIva)
        </dd>
        @if (Model.Factura.TipoDteCodigo == "18" || Model.Factura.TipoDTE == 18)
        {
            <dt class="col-sm-2">Documento original</dt>
            <dd class="col-sm-10">@(Model.Factura.FacturaOriginal?.CodigoGeneracion ?? Model.Factura.FacturaOriginalId?.ToString() ?? "-")</dd>
            <dt class="col-sm-2">Tipo de retorno</dt>
            <dd class="col-sm-10">@Model.Factura.TipoRetorno</dd>
            <dt class="col-sm-2">Motivo</dt>
            <dd class="col-sm-10">@Model.Factura.MotivoRetorno</dd>
            <dt class="col-sm-2">Líneas retornadas</dt>
            <dd class="col-sm-10">
                @foreach (var linea in Model.Factura.DetallesRetorno.OrderBy(x => x.NumeroItemOriginal))
                {
                    <div>#@linea.NumeroItemOriginal — @linea.Descripcion: @linea.CantidadRetornada</div>
                }
            </dd>
        }
    </dl>
</div>
<div>
    @if ((Model.Factura.TipoDteCodigo == "03" || Model.Factura.TipoDTE == 3) && !string.IsNullOrWhiteSpace(Model.Factura.SelloRecepcion) && !Model.Factura.Anulada)
    {
        <a asp-page="./Nota" asp-route-FacturaId="@Model.Factura.FacturaId" asp-route-TipoNota="05">Crear nota de crédito</a><text> | </text>
        <a asp-page="./Nota" asp-route-FacturaId="@Model.Factura.FacturaId" asp-route-TipoNota="06">Crear nota de débito</a><text> | </text>
    }
    @if (Model.PuedeRetornar)
    {
        <a asp-page="./Retorno" asp-route-FacturaId="@Model.Factura.FacturaId">Crear evento de retorno</a><text> | </text>
    }
    @if (string.IsNullOrWhiteSpace(Model.Factura.JsonDte)
        && string.IsNullOrWhiteSpace(Model.Factura.TipoDteCodigo)
        && Model.Factura.EstadoTransmision == "Preparado")
    {
        <a asp-page="./Edit" asp-route-id="@Model.Factura.FacturaId">Editar</a><text> | </text>
    }
    <a asp-page="./Index">Back to List</a>
</div>
