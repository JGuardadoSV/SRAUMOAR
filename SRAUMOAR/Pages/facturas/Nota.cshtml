@page "/facturas/nota"
@model SRAUMOAR.Pages.facturas.NotaModel
@using SRAUMOAR.Modelos.FacturacionElectronica
@{
    ViewData["Title"] = Model.TipoNota == DteTipos.NotaDebito ? "Nota de débito" : "Nota de crédito";
}

<div class="container py-4">
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">La nota se relaciona con el DTE 03 original y conserva su ambiente fiscal.</p>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    @if (Model.Resultado is { Aceptado: true } resultado)
    {
        <div class="alert alert-success">
            Nota @resultado.TipoNota aceptada en ambiente @resultado.AmbienteFiscal.<br />
            Código: @resultado.CodigoGeneracion<br />
            Sello: @resultado.SelloRecepcion
        </div>
    }

    @if (Model.Factura is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Factura original</dt>
                    <dd class="col-sm-9">@Model.Factura.NumeroControl</dd>
                    <dt class="col-sm-3">Código de generación</dt>
                    <dd class="col-sm-9">@Model.Factura.CodigoGeneracion</dd>
                    <dt class="col-sm-3">Ambiente fiscal</dt>
                    <dd class="col-sm-9">@Model.Factura.AmbienteFiscal</dd>
                    <dt class="col-sm-3">Total original</dt>
                    <dd class="col-sm-9">$@Model.Factura.TotalPagar.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        <form method="post" class="card">
            <div class="card-body">
                <input type="hidden" asp-for="FacturaId" />
                @if (Model.RequiereGeografia)
                {
                    <div class="alert alert-info">El documento histórico no contiene distrito. Seleccione la ubicación fiscal actual del receptor para esta nota; el JSON original no será modificado.</div>
                    @foreach (var campo in new[] { ("DepartamentoReceptor", "Departamento", "CAT-012", Model.DepartamentoReceptor), ("MunicipioReceptor", "Municipio", "CAT-013", Model.MunicipioReceptor), ("DistritoReceptor", "Distrito", "CAT-008", Model.DistritoReceptor) })
                    {
                        <div class="mb-3">
                            <label class="form-label" for="@(campo.Item1)Texto">@campo.Item2 del receptor</label>
                            <div class="input-group">
                                <input type="hidden" id="@campo.Item1" name="@campo.Item1" value="@campo.Item4" />
                                <input class="form-control" id="@(campo.Item1)Texto" readonly value="@Model.CatalogosGeograficos.FirstOrDefault(x => x.CodigoCatalogo == campo.Item3 && x.Codigo == campo.Item4 && (campo.Item3 != "CAT-013" || x.AmbitoDepartamento == Model.DepartamentoReceptor) && (campo.Item3 != "CAT-008" || x.AmbitoDepartamento == Model.DepartamentoReceptor && x.AmbitoMunicipio == Model.MunicipioReceptor))?.Descripcion" placeholder="Seleccione en Buscar" />
                                <button type="button" class="btn btn-outline-secondary buscar-geografia" data-target="@campo.Item1" data-catalogo="@campo.Item3">Buscar @campo.Item2.ToLowerInvariant()</button>
                            </div>
                        </div>
                    }
                }
                <div class="mb-3">
                    <label class="form-label">Tipo de nota</label>
                    <select class="form-select" asp-for="TipoNota">
                        <option value="05">05 - Nota de crédito</option>
                        <option value="06">06 - Nota de débito</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Monto de la operación a ajustar</label>
                    <input class="form-control" asp-for="Monto" type="number" min="0.01" step="0.01" />
                    <div class="form-text">Operación original: $@Model.MontoOperacionOriginal.ToString("N2"). Se conservan proporcionalmente las retenciones y percepciones; el neto a pagar puede ser diferente. El crédito no puede superar el saldo de la operación.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Motivo</label>
                    <textarea class="form-control" asp-for="Motivo" maxlength="500"></textarea>
                </div>
                <button class="btn btn-primary" type="submit">Generar y transmitir nota</button>
                <a class="btn btn-secondary" asp-page="./Details" asp-route-id="@Model.FacturaId">Cancelar</a>
            </div>
        </form>
    }
</div>

<div class="modal fade" id="geografiaNota" tabindex="-1" aria-labelledby="geografiaNotaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="geografiaNotaTitulo">Buscar ubicación del receptor</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
        <div class="modal-body"><input class="form-control mb-3" id="buscarGeografiaNota" type="search" aria-label="Buscar por código o nombre" placeholder="Código o nombre" /><div id="resultadosGeografiaNota" class="list-group"></div></div>
    </div></div>
</div>
@section Scripts {
<script>
(() => {
    const datos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CatalogosGeograficos.Select(x => new { catalogo = x.CodigoCatalogo, codigo = x.Codigo, nombre = x.Descripcion, departamento = x.AmbitoDepartamento, municipio = x.AmbitoMunicipio })));
    const elemento = document.getElementById('geografiaNota'), modal = new bootstrap.Modal(elemento);
    const buscador = document.getElementById('buscarGeografiaNota'), lista = document.getElementById('resultadosGeografiaNota');
    let destino, catalogo;
    document.querySelectorAll('.buscar-geografia').forEach(b => b.addEventListener('click', () => {
        destino = b.dataset.target; catalogo = b.dataset.catalogo;
        if (catalogo === 'CAT-013' && !document.getElementById('DepartamentoReceptor').value) {
            window.alert('Seleccione primero el departamento.'); return;
        }
        if (catalogo === 'CAT-008' && !document.getElementById('MunicipioReceptor').value) {
            window.alert('Seleccione primero el municipio.'); return;
        }
        buscador.value = ''; render(); modal.show();
    }));
    elemento.addEventListener('shown.bs.modal', () => buscador.focus());
    buscador.addEventListener('input', render);
    function render() {
        lista.replaceChildren();
        const q = buscador.value.trim().toLocaleLowerCase('es');
        const departamento = document.getElementById('DepartamentoReceptor').value;
        const municipio = document.getElementById('MunicipioReceptor').value;
        datos.filter(x => x.catalogo === catalogo
            && (catalogo !== 'CAT-013' || x.departamento === departamento)
            && (catalogo !== 'CAT-008' || x.departamento === departamento && x.municipio === municipio)
            && `${x.codigo} ${x.nombre}`.toLocaleLowerCase('es').includes(q)).slice(0, 100).forEach(x => {
            const b = document.createElement('button'); b.type = 'button'; b.className = 'list-group-item list-group-item-action'; b.textContent = `${x.codigo} — ${x.nombre}`;
            b.addEventListener('click', () => {
                document.getElementById(destino).value = x.codigo; document.getElementById(destino + 'Texto').value = x.nombre;
                const dependientes = destino === 'DepartamentoReceptor' ? ['MunicipioReceptor', 'DistritoReceptor'] : destino === 'MunicipioReceptor' ? ['DistritoReceptor'] : [];
                dependientes.forEach(id => { document.getElementById(id).value = ''; document.getElementById(id + 'Texto').value = ''; });
                modal.hide();
            }); lista.append(b);
        });
        if (!lista.childElementCount) lista.textContent = 'Sin resultados. Verifique que los catálogos fiscales estén importados.';
    }
})();
</script>
}
