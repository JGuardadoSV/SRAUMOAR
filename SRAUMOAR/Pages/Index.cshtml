@page
@model SRAUMOAR.Pages.IndexModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión · UMOAR</title>
    <link rel="stylesheet" href="~/css/login-campus.css" asp-append-version="true" />
</head>
<body>
    <main class="campus">
        <section class="access" aria-labelledby="login-title">
            <div class="access-inner">
                <div class="brand">
                    <img src="~/images/logoUmoar.jpg" width="56" height="56" alt="" />
                    <div><strong>UMOAR</strong><span>Sistema de Registro Académico</span></div>
                </div>
                <h1 id="login-title">Iniciar sesión</h1>
                <p class="intro">Ingresa con tu correo institucional.</p>
                @if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
                {
                    <div class="login-error" role="alert">@error</div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="login-error" role="alert"></div>
                }
                <form method="post">
                    <label for="loginEmail">Correo electrónico</label>
                    <input name="NombreUsuario" id="loginEmail" type="email" autocomplete="username" required />
                    <label for="loginPassword">Contraseña</label>
                    <div class="password">
                        <input name="Clave" id="loginPassword" type="password" autocomplete="current-password" required />
                        <button type="button" id="togglePassword" aria-controls="loginPassword">Mostrar</button>
                    </div>
                    <button class="sign-in" type="submit">Ingresar</button>
                </form>
            </div>
        </section>
        <aside class="campus-image" aria-label="Información de la universidad">
            <img src="@Url.RouteUrl("ImagenCampusLogin")" alt="Aviso institucional de UMOAR" />
        </aside>
    </main>
    <script>
        const toggle = document.getElementById('togglePassword');
        const password = document.getElementById('loginPassword');
        toggle.addEventListener('click', () => {
            const mostrar = password.type === 'password';
            password.type = mostrar ? 'text' : 'password';
            toggle.textContent = mostrar ? 'Ocultar' : 'Mostrar';
        });
    </script>
</body>
</html>
