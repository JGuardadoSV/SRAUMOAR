@page
@model SRAUMOAR.Pages.administracion.facturacion.CatalogosModel
@{
    ViewData["Title"] = "Catálogos de Facturación Electrónica";
}

<h1>Catálogos de Facturación Electrónica</h1>
<p>Importe el archivo oficial de catálogos. La importación reemplaza únicamente la versión seleccionada.</p>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" enctype="multipart/form-data" asp-page-handler="Importar">
    <div class="mb-3">
        <label asp-for="Archivo" class="form-label">Archivo Excel</label>
        <input asp-for="Archivo" type="file" accept=".xlsx" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Version" class="form-label">Versión</label>
        <input asp-for="Version" class="form-control" maxlength="20" />
    </div>
    <button type="submit" class="btn btn-primary">Importar catálogos</button>
</form>
