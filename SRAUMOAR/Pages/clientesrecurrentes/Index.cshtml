@page
@model SRAUMOAR.Pages.clientesrecurrentes.IndexModel
@{
    ViewData["Title"] = "Clientes recurrentes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Clientes recurrentes</h1>
            <p class="text-muted mb-0">Administre los receptores guardados para facturación.</p>
        </div>
        <a asp-page="./Edit" class="btn btn-primary">Nuevo cliente</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>NIT / DUI</th>
                        <th>NRC</th>
                        <th>Teléfono</th>
                        <th>Gran contribuyente</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay clientes recurrentes guardados.</td></tr>
                }
                else
                {
                    foreach (var cliente in Model.Clientes)
                    {
                        <tr>
                            <td>
                                <strong>@cliente.Nombre</strong>
                                <small class="d-block text-muted">@cliente.Correo</small>
                            </td>
                            <td>@cliente.Nit</td>
                            <td>@cliente.Nrc</td>
                            <td>@cliente.Telefono</td>
                            <td>@(cliente.GranContribuyente ? "Sí" : "No")</td>
                            <td class="text-end">
                                <a asp-page="./Edit" asp-route-id="@cliente.ClienteRecurrenteId" class="btn btn-sm btn-outline-primary">Editar</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
