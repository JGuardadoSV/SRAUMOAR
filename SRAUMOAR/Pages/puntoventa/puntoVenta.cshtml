@page "/puntoventa/puntoVenta"

@using System.Text.Json
@model SRAUMOAR.Pages.puntoventa.puntoVentaModel
@{
    ViewData["Title"] = "Facturacion";
    var tieneProductos = Model.Factura.Productos.Any();
}

<section class="pv-shell">
    <form method="post" id="puntoVentaForm" novalidate>
        <div class="pv-header">
            <div>
                <div class="pv-eyebrow">Punto de venta</div>
                <h1>Facturacion</h1>
                <p>Emision de documentos tributarios electronicos para colecturia.</p>
            </div>
            <div class="pv-status" id="estadoDocumento">
                <i class="bi bi-exclamation-circle"></i>
                <span>Seleccione documento</span>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger pv-validation"></div>

        <div class="pv-docbar">
            <div class="pv-docbar-main">
                <label asp-for="Factura.TipoDocumento">Tipo de documento</label>
                <select class="form-control form-control-lg" asp-for="Factura.TipoDocumento" id="tipoDocumentoSelect">
                    <option value="">Seleccione...</option>
                    <option value="01">01 - Consumidor Final</option>
                    <option value="02">02 - Credito Fiscal</option>
                    <option value="14">14 - Sujeto Excluido</option>
                    <option value="15">15 - Donacion</option>
                </select>
                <span asp-validation-for="Factura.TipoDocumento" class="text-danger"></span>
            </div>
            <div class="pv-docbar-help">
                <i class="bi bi-info-circle"></i>
                <span>El IVA se aplica solo para Credito Fiscal. Primero seleccione el documento para habilitar el registro de productos.</span>
            </div>
        </div>

        <div id="alertaTipoDocumento" class="pv-inline-warning" style="display: none;">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Debe seleccionar un tipo de documento antes de continuar con la facturacion.</span>
        </div>

        <div class="modal fade pv-document-modal" id="tipoDocumentoModal" tabindex="-1" aria-labelledby="tipoDocumentoModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <span class="pv-modal-eyebrow">Antes de iniciar</span>
                            <h5 class="modal-title" id="tipoDocumentoModalLabel">Seleccione el tipo de factura</h5>
                        </div>
                    </div>
                    <div class="modal-body">
                        <p class="pv-modal-copy">Esta seleccion define los campos requeridos, el calculo de IVA y las reglas de la factura.</p>
                        <label for="modalTipoDocumentoSelect" class="form-label">Tipo de documento</label>
                        <select class="form-control form-control-lg" id="modalTipoDocumentoSelect">
                            <option value="">Seleccione...</option>
                            <option value="01">01 - Consumidor Final</option>
                            <option value="02">02 - Credito Fiscal</option>
                            <option value="14">14 - Sujeto Excluido</option>
                            <option value="15">15 - Donacion</option>
                        </select>
                        <div class="pv-modal-error" id="modalTipoDocumentoError" style="display: none;">
                            <i class="bi bi-exclamation-triangle"></i>
                            Seleccione un tipo de documento para continuar.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="confirmarTipoDocumento">
                            <i class="bi bi-check2-circle"></i>
                            Continuar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="catalogoBusquedaModal" tabindex="-1" aria-labelledby="catalogoBusquedaModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <span class="pv-modal-eyebrow">Catalogo fiscal</span>
                            <h5 class="modal-title" id="catalogoBusquedaModalLabel">Buscar valor</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="search" class="form-control" id="catalogoBusquedaTexto" placeholder="Escriba codigo o descripcion..." autocomplete="off" />
                        </div>
                        <div id="catalogoBusquedaCargando" class="text-muted small" style="display: none;">Buscando...</div>
                        <div id="catalogoBusquedaVacio" class="text-muted small" style="display: none;">No se encontraron resultados.</div>
                        <div class="list-group" id="catalogoBusquedaResultados" role="listbox"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="pv-layout">
            <div class="pv-workspace">
                <div class="pv-panel">
                    <div class="pv-panel-header">
                        <div>
                            <span class="pv-step">01</span>
                            <h2>Datos del receptor</h2>
                        </div>
                        <i class="bi bi-person-vcard"></i>
                    </div>

                    <div class="pv-grid pv-grid-2">
                        <div class="form-group">
                            <label>NIT / DUI / Documento</label>
                            <input type="text" class="form-control" asp-for="Factura.Receptor.Nit" autocomplete="off" />
                        </div>
                        <div class="form-group campos-credito-fiscal" style="display: none;">
                            <label>NRC</label>
                            <input type="text" class="form-control" asp-for="Factura.Receptor.Nrc" autocomplete="off" />
                            <span asp-validation-for="Factura.Receptor.Nrc" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="pv-grid pv-grid-2">
                        <div class="form-group">
                            <label>Nombre</label>
                            <input type="text" class="form-control" asp-for="Factura.Receptor.Nombre" autocomplete="off" />
                            <span asp-validation-for="Factura.Receptor.Nombre" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Nombre comercial</label>
                            <input type="text" class="form-control" asp-for="Factura.Receptor.NombreComercial" autocomplete="off" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Direccion</label>
                        <input type="text" class="form-control" asp-for="Factura.Receptor.Direccion.Complemento" autocomplete="off" />
                    </div>

                    <div class="pv-grid pv-grid-3">
                        <div class="form-group">
                            <label>Departamento</label>
                            <div class="input-group">
                                <input type="text" class="form-control catalogo-valor" id="Factura_Receptor_CodigoDepartamentoTexto" placeholder="Buscar departamento..." readonly />
                                <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="departamento" data-target-code="Factura_Receptor_CodigoDepartamento" data-target-text="Factura_Receptor_CodigoDepartamentoTexto" title="Buscar departamento">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Factura.Receptor.CodigoDepartamento" id="Factura_Receptor_CodigoDepartamento" />
                        </div>
                        <div class="form-group">
                            <label>Municipio</label>
                            <div class="input-group">
                                <input type="text" class="form-control catalogo-valor" id="Factura_Receptor_CodigoMunicipioTexto" placeholder="Seleccione departamento primero..." readonly />
                                <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="municipio" data-target-code="Factura_Receptor_CodigoMunicipio" data-target-text="Factura_Receptor_CodigoMunicipioTexto" title="Buscar municipio">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Factura.Receptor.CodigoMunicipio" id="Factura_Receptor_CodigoMunicipio" />
                        </div>
                        <div class="form-group">
                            <label>Distrito fiscal</label>
                            <div class="input-group">
                                <input type="text" class="form-control catalogo-valor" id="Factura_Receptor_DistritoTexto" placeholder="Seleccione municipio primero..." readonly />
                                <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="distrito" data-target-code="Factura_Receptor_DistritoId" data-target-text="Factura_Receptor_DistritoTexto" title="Buscar distrito fiscal">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Factura.Receptor.DistritoId" id="Factura_Receptor_DistritoId" />
                            <small>Seleccione explícitamente el distrito del receptor. No se deduce de la dirección legacy.</small>
                        </div>
                        <div class="form-group">
                            <label>Telefono</label>
                            <input type="text" class="form-control" asp-for="Factura.Receptor.Telefono" autocomplete="off" />
                        </div>
                    </div>

                    <div class="pv-grid pv-grid-2">
                        <div class="form-group">
                            <label>Correo</label>
                            <input type="email" class="form-control" asp-for="Factura.Receptor.Correo" autocomplete="off" />
                        </div>
                        <div class="form-group campo-pais" style="display: none;">
                            <label>País de nacionalidad del donante</label>
                            <div class="input-group">
                                <input type="text" class="form-control catalogo-valor" id="Factura_CodigoPaisTexto" placeholder="Buscar pais..." readonly />
                                <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="pais" data-target-code="Factura_CodigoPais" data-target-text="Factura_CodigoPaisTexto" title="Buscar pais">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Factura.CodigoPais" id="Factura_CodigoPais" />
                            <span asp-validation-for="Factura.CodigoPais" class="text-danger"></span>
                        </div>
                        <div class="form-group campo-pais" style="display: none;">
                            <label asp-for="Factura.Receptor.CodigoDomicilioFiscal">Domicilio fiscal del donante</label>
                            <select asp-for="Factura.Receptor.CodigoDomicilioFiscal" class="form-control">
                                <option value="">Seleccione...</option>
                                <option value="1">Domiciliado</option>
                                <option value="2">No domiciliado</option>
                            </select>
                        </div>
                    </div>

                    <div class="pv-conditional campos-credito-fiscal" style="display: none;">
                        <div class="pv-conditional-title">
                            <i class="bi bi-briefcase"></i>
                            <span>Actividad economica</span>
                        </div>
                        <div class="pv-grid pv-grid-2">
                            <div class="form-group">
                                <label>Giro</label>
                                <input type="text" class="form-control" asp-for="Factura.Receptor.DescActividad" placeholder="Se llenara al seleccionar codigo" readonly />
                                <span asp-validation-for="Factura.Receptor.DescActividad" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Codigo de actividad economica</label>
                                <div class="input-group">
                                    <input type="text" class="form-control catalogo-valor" id="Factura_Receptor_CodActividadTexto" placeholder="Buscar actividad economica..." readonly />
                                    <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="actividad" data-target-code="Factura_Receptor_CodActividad" data-target-text="Factura_Receptor_CodActividadTexto" title="Buscar actividad economica">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <input type="hidden" asp-for="Factura.Receptor.CodActividad" id="Factura_Receptor_CodActividad" />
                                <span asp-validation-for="Factura.Receptor.CodActividad" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="pv-grid pv-grid-2">
                        <div class="form-group campo-tipo-donacion" style="display: none;">
                            <label>Tipo de donacion</label>
                            <div class="input-group">
                                <input type="text" class="form-control catalogo-valor" id="Factura_TipoDonacionTexto" placeholder="Buscar tipo de donacion..." readonly />
                                <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="donacion" data-target-code="Factura_TipoDonacion" data-target-text="Factura_TipoDonacionTexto" title="Buscar tipo de donacion">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Factura.TipoDonacion" id="Factura_TipoDonacion" />
                            <span asp-validation-for="Factura.TipoDonacion" class="text-danger"></span>
                        </div>
                        <div class="form-group campo-sujeto-excluido" style="display: none;">
                            <label>Tipo de operacion</label>
                            <div class="input-group">
                                <input type="text" class="form-control catalogo-valor" id="Factura_TipoOperacionTexto" placeholder="Buscar tipo de operacion..." readonly />
                                <button type="button" class="btn btn-outline-secondary btn-buscar-catalogo" data-catalogo="operacion" data-target-code="Factura_TipoOperacion" data-target-text="Factura_TipoOperacionTexto" title="Buscar tipo de operacion">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Factura.TipoOperacion" id="Factura_TipoOperacion" />
                            <span asp-validation-for="Factura.TipoOperacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="campo-sujeto-excluido pv-switch" style="display: none;">
                        <input type="checkbox" class="form-check-input" asp-for="Factura.Retencion" id="retencionRentaCheck" />
                        <label class="form-check-label" for="retencionRentaCheck">
                            Aplicar retencion de renta del 10%
                        </label>
                    </div>
                </div>

                <div class="pv-panel">
                    <div class="pv-panel-header">
                        <div>
                            <span class="pv-step">02</span>
                            <h2>Agregar producto</h2>
                        </div>
                        <i class="bi bi-plus-square"></i>
                    </div>

                    <div class="pv-product-grid">
                        <div class="form-group">
                            <label>Codigo</label>
                            <input type="text" class="form-control" asp-for="Factura.CodigoProducto" autocomplete="off" />
                        </div>
                        <div class="form-group pv-product-description">
                            <label>Descripcion</label>
                            <input type="text" class="form-control" asp-for="Factura.DescripcionProducto" autocomplete="off" />
                        </div>
                        <div class="form-group">
                            <label>Cantidad</label>
                            <input type="number" step="0.01" class="form-control" asp-for="Factura.CantidadProducto" />
                        </div>
                        <div class="form-group">
                            <label>Precio unit.</label>
                            <input type="number" step="0.01" class="form-control" asp-for="Factura.PrecioProducto" />
                        </div>
                        <div class="pv-product-actions">
                            <div class="pv-switch pv-switch-compact">
                                <input type="checkbox" class="form-check-input" asp-for="Factura.ProductoExento" />
                                <label class="form-check-label" asp-for="Factura.ProductoExento">Exento</label>
                            </div>
                            <button type="submit" asp-page-handler="AgregarProducto" class="btn btn-success btn-agregar-producto" disabled>
                                <i class="bi bi-plus-lg"></i>
                                <span>Agregar</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pv-panel pv-emisor">
                    <button class="pv-collapse-button" type="button" data-bs-toggle="collapse" data-bs-target="#datosEmisor" aria-expanded="false" aria-controls="datosEmisor">
                        <span>
                            <i class="bi bi-building"></i>
                            Datos del emisor
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="collapse" id="datosEmisor">
                        <div class="pv-emisor-grid">
                            <div><span>NIT</span><strong>@Model.Factura.Emisor.Nit</strong></div>
                            <div><span>NRC</span><strong>@Model.Factura.Emisor.Nrc</strong></div>
                            <div><span>Nombre</span><strong>@Model.Factura.Emisor.Nombre</strong></div>
                            <div><span>Nombre comercial</span><strong>@Model.Factura.Emisor.NombreComercial</strong></div>
                            <div><span>Telefono</span><strong>@Model.Factura.Emisor.Telefono</strong></div>
                            <div><span>Correo</span><strong>@Model.Factura.Emisor.Correo</strong></div>
                            <div class="pv-emisor-address"><span>Direccion</span><strong>@Model.Factura.Emisor.Direccion.Complemento</strong></div>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="pv-summary">
                <div class="pv-summary-card">
                    <div class="pv-summary-header">
                        <div>
                            <span class="pv-step">03</span>
                            <h2>Carrito y totales</h2>
                        </div>
                        <span class="pv-item-count">@Model.Factura.Productos.Count item(s)</span>
                    </div>

                    @if (tieneProductos)
                    {
                        <div class="pv-cart">
                            @for (int i = 0; i < Model.Factura.Productos.Count; i++)
                            {
                                <div class="pv-cart-item"
                                     data-subtotal="@Model.Factura.Productos[i].SubTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-exento="@(Model.Factura.Productos[i].EsExento ? "true" : "false")">
                                    <div class="pv-cart-main">
                                        <span class="pv-cart-code">@Model.Factura.Productos[i].Codigo</span>
                                        <strong>@Model.Factura.Productos[i].Descripcion</strong>
                                        <small>@Model.Factura.Productos[i].Cantidad.ToString("N2") x $@Model.Factura.Productos[i].PrecioUnitario.ToString("N2")</small>
                                    </div>
                                    <div class="pv-cart-side">
                                        <span class="pv-badge @(Model.Factura.Productos[i].EsExento ? "pv-badge-exento" : "pv-badge-gravado")">
                                            @(Model.Factura.Productos[i].EsExento ? "Exento" : "Gravado")
                                        </span>
                                        <strong>$@Model.Factura.Productos[i].SubTotal.ToString("N2")</strong>
                                        <button type="submit" asp-page-handler="EliminarProducto" asp-route-id="@Model.Factura.Productos[i].Id" class="btn btn-outline-danger btn-sm" title="Eliminar producto">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pv-empty">
                            <i class="bi bi-cart"></i>
                            <strong>Sin productos</strong>
                            <span>Agregue productos para habilitar el resumen y el procesamiento.</span>
                        </div>
                    }

                    <div class="pv-totals @(tieneProductos ? "" : "pv-totals-muted")">
                        <div class="pv-total-row">
                            <span>Subtotal exento</span>
                            <strong id="totalExentoValue">$@Model.Factura.TotalExento.ToString("N2")</strong>
                        </div>
                        <div class="pv-total-row">
                            <span>Subtotal gravado</span>
                            <strong id="totalGravadoValue">$@Model.Factura.TotalGravado.ToString("N2")</strong>
                        </div>
                        <div class="pv-total-row iva-row">
                            <span>IVA (13%)</span>
                            <strong id="ivaValue">$@Model.Factura.IVA.ToString("N2")</strong>
                        </div>
                        <div class="pv-total-row retencion-row" style="@(Model.Factura.TipoDocumento == "14" && Model.Factura.Retencion ? "" : "display: none;")">
                            <span>Retencion renta (10%)</span>
                            <strong class="text-danger" id="retencionValue">-$@((Model.Factura.Productos.Sum(p => p.Cantidad * p.PrecioUnitario) * 0.10M).ToString("N2"))</strong>
                        </div>
                        <div class="pv-total-row pv-grand-total">
                            <span>Total general</span>
                            <strong id="totalGeneralValue">$@Model.Factura.TotalGeneralConRetencion.ToString("N2")</strong>
                        </div>
                    </div>

                    @if (tieneProductos)
                    {
                        <button type="submit" asp-page-handler="ProcesarFactura" class="btn btn-primary btn-lg pv-process-button">
                            <i class="bi bi-receipt-cutoff"></i>
                            <span>Procesar factura</span>
                        </button>
                    }
                </div>
            </aside>
        </div>

        @for (int i = 0; i < Model.Factura.Productos.Count; i++)
        {
            <input type="hidden" asp-for="Factura.Productos[i].Id" />
            <input type="hidden" asp-for="Factura.Productos[i].Codigo" />
            <input type="hidden" asp-for="Factura.Productos[i].Descripcion" />
            <input type="hidden" asp-for="Factura.Productos[i].Cantidad" />
            <input type="hidden" asp-for="Factura.Productos[i].PrecioUnitario" />
            <input type="hidden" asp-for="Factura.Productos[i].EsExento" />
        }

        <input type="hidden" asp-for="Factura.Emisor.Nit" />
        <input type="hidden" asp-for="Factura.Emisor.Nrc" />
        <input type="hidden" asp-for="Factura.Emisor.Nombre" />
        <input type="hidden" asp-for="Factura.Emisor.NombreComercial" />
        <input type="hidden" asp-for="Factura.Emisor.Direccion.Complemento" />
        <input type="hidden" asp-for="Factura.Emisor.Telefono" />
        <input type="hidden" asp-for="Factura.Emisor.Correo" />
    </form>
</section>

@section Styles {
    <style>
        .pv-shell {
            --pv-ink: #18212f;
            --pv-muted: #64748b;
            --pv-line: #dbe3ea;
            --pv-surface: #ffffff;
            --pv-soft: #f6f8fb;
            --pv-accent: #0f766e;
            --pv-accent-dark: #115e59;
            --pv-warning: #b7791f;
            --pv-danger: #b42318;
            padding: 1rem 0 1.5rem;
            color: var(--pv-ink);
        }

        .pv-header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: center;
            margin-bottom: 1rem;
            padding: 1rem 1.1rem;
            background: var(--pv-surface);
            border: 1px solid var(--pv-line);
            border-radius: 8px;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
        }

        .pv-eyebrow {
            color: var(--pv-accent);
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .pv-header h1 {
            margin: 0.1rem 0;
            font-size: 1.65rem;
            font-weight: 700;
        }

        .pv-header p {
            margin: 0;
            color: var(--pv-muted);
        }

        .pv-status {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 42px;
            padding: 0.5rem 0.75rem;
            border-radius: 8px;
            background: #fff8e6;
            color: var(--pv-warning);
            border: 1px solid #f3d79b;
            font-weight: 700;
            white-space: nowrap;
        }

        .pv-status.is-ready {
            background: #eaf8f4;
            color: var(--pv-accent-dark);
            border-color: #b8e3d8;
        }

        .pv-docbar,
        .pv-panel,
        .pv-summary-card {
            background: var(--pv-surface);
            border: 1px solid var(--pv-line);
            border-radius: 8px;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
        }

        .pv-docbar {
            display: grid;
            grid-template-columns: minmax(280px, 420px) 1fr;
            gap: 1rem;
            align-items: end;
            padding: 1rem;
            margin-bottom: 0.8rem;
        }

        .pv-docbar label,
        .pv-panel label {
            margin-bottom: 0.35rem;
            color: #334155;
            font-size: 0.88rem;
            font-weight: 700;
        }

        .pv-docbar-help {
            display: flex;
            gap: 0.5rem;
            align-items: flex-start;
            color: var(--pv-muted);
            line-height: 1.35;
        }

        .pv-inline-warning {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            margin-bottom: 0.8rem;
            padding: 0.7rem 0.85rem;
            border: 1px solid #f3d79b;
            border-left: 4px solid #f2b63f;
            border-radius: 8px;
            background: #fff8e6;
            color: #7a4f00;
            font-weight: 600;
        }

        .pv-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(320px, 390px);
            gap: 1rem;
            align-items: start;
        }

        .pv-workspace {
            display: grid;
            gap: 1rem;
        }

        .pv-panel {
            padding: 1rem;
        }

        .pv-panel-header,
        .pv-summary-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .pv-panel-header > div,
        .pv-summary-header > div {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .pv-panel-header h2,
        .pv-summary-header h2 {
            margin: 0;
            font-size: 1.08rem;
            font-weight: 700;
        }

        .pv-panel-header > i,
        .pv-summary-header > i {
            color: var(--pv-muted);
            font-size: 1.2rem;
        }

        .pv-step {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #eaf8f4;
            color: var(--pv-accent-dark);
            font-weight: 800;
            font-size: 0.78rem;
        }

        .pv-grid {
            display: grid;
            gap: 0.85rem;
        }

        .pv-grid-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pv-grid-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .pv-panel .form-control {
            min-height: 40px;
            border-color: #ccd6df;
            border-radius: 6px;
        }

        .pv-panel .form-control:focus,
        .pv-docbar .form-control:focus {
            border-color: var(--pv-accent);
            box-shadow: 0 0 0 0.2rem rgba(15, 118, 110, 0.16);
        }

        .pv-conditional {
            margin: 0.4rem 0 0.9rem;
            padding: 0.85rem;
            background: #f8fbfc;
            border: 1px solid #dce8ea;
            border-left: 4px solid #0ea5a4;
            border-radius: 8px;
        }

        .pv-conditional-title {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            margin-bottom: 0.75rem;
            color: #155e75;
            font-weight: 700;
        }

        .pv-switch {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-height: 40px;
            padding: 0.55rem 0.7rem;
            border: 1px solid var(--pv-line);
            border-radius: 8px;
            background: var(--pv-soft);
        }

        .pv-switch .form-check-input {
            margin: 0;
        }

        .pv-switch label {
            margin: 0;
        }

        .pv-product-grid {
            display: grid;
            grid-template-columns: minmax(100px, 0.8fr) minmax(220px, 2fr) minmax(110px, 0.8fr) minmax(120px, 0.9fr) minmax(160px, auto);
            gap: 0.85rem;
            align-items: end;
        }

        .pv-product-actions {
            display: grid;
            gap: 0.55rem;
        }

        .pv-product-actions .btn {
            min-height: 40px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 0.4rem;
            border-radius: 6px;
            font-weight: 700;
        }

        .pv-switch-compact {
            justify-content: center;
            min-height: 40px;
            padding: 0.45rem;
        }

        .pv-emisor {
            padding: 0;
            overflow: hidden;
        }

        .pv-collapse-button {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1rem;
            border: 0;
            background: #f8fafc;
            color: var(--pv-ink);
            font-weight: 700;
        }

        .pv-collapse-button span {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .pv-emisor-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            padding: 1rem;
        }

        .pv-emisor-grid div {
            padding: 0.65rem;
            border: 1px solid var(--pv-line);
            border-radius: 8px;
            background: #fff;
        }

        .pv-emisor-grid span {
            display: block;
            color: var(--pv-muted);
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 700;
        }

        .pv-emisor-grid strong {
            display: block;
            margin-top: 0.2rem;
            overflow-wrap: anywhere;
        }

        .pv-emisor-address {
            grid-column: 1 / -1;
        }

        .pv-summary {
            position: sticky;
            top: 1rem;
        }

        .pv-summary-card {
            padding: 1rem;
        }

        .pv-item-count {
            color: var(--pv-muted);
            font-weight: 700;
            white-space: nowrap;
        }

        .pv-cart {
            display: grid;
            gap: 0.65rem;
            max-height: 430px;
            overflow: auto;
            padding-right: 0.15rem;
        }

        .pv-cart-item {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 0.75rem;
            align-items: center;
            padding: 0.75rem;
            border: 1px solid var(--pv-line);
            border-radius: 8px;
            background: #fbfdff;
        }

        .pv-cart-main {
            min-width: 0;
        }

        .pv-cart-code {
            display: inline-block;
            margin-bottom: 0.25rem;
            color: var(--pv-muted);
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .pv-cart-main strong {
            display: block;
            overflow-wrap: anywhere;
        }

        .pv-cart-main small {
            color: var(--pv-muted);
        }

        .pv-cart-side {
            display: grid;
            gap: 0.35rem;
            justify-items: end;
        }

        .pv-badge {
            display: inline-flex;
            align-items: center;
            min-height: 24px;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            color: #fff;
            font-size: 0.76rem;
            font-weight: 800;
        }

        .pv-badge-exento {
            background: #15803d;
        }

        .pv-badge-gravado {
            background: #b42318;
        }

        .pv-empty {
            display: grid;
            justify-items: center;
            gap: 0.3rem;
            padding: 1.4rem 0.75rem;
            text-align: center;
            color: var(--pv-muted);
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            background: #f8fafc;
        }

        .pv-empty i {
            font-size: 1.8rem;
            color: #94a3b8;
        }

        .pv-empty strong {
            color: var(--pv-ink);
        }

        .pv-totals {
            display: grid;
            gap: 0.55rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--pv-line);
        }

        .pv-totals-muted {
            opacity: 0.65;
        }

        .pv-total-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #334155;
        }

        .pv-total-row strong {
            color: var(--pv-ink);
            white-space: nowrap;
        }

        .pv-grand-total {
            margin-top: 0.35rem;
            padding-top: 0.75rem;
            border-top: 1px solid var(--pv-line);
            font-size: 1.1rem;
        }

        .pv-grand-total strong {
            color: var(--pv-accent-dark);
            font-size: 1.35rem;
        }

        .pv-process-button {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 1rem;
            min-height: 48px;
            border-radius: 8px;
            font-weight: 800;
        }

        .pv-validation:empty {
            display: none;
        }

        .pv-document-modal .modal-content {
            border: 0;
            border-radius: 8px;
            box-shadow: 0 22px 55px rgba(15, 23, 42, 0.28);
        }

        .pv-document-modal .modal-header,
        .pv-document-modal .modal-footer {
            border-color: #e2e8f0;
        }

        .pv-document-modal .modal-title {
            margin-top: 0.15rem;
            font-weight: 800;
        }

        .pv-modal-eyebrow {
            color: var(--pv-accent);
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .pv-modal-copy {
            color: var(--pv-muted);
            margin-bottom: 1rem;
        }

        .pv-modal-error {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            margin-top: 0.75rem;
            color: var(--pv-danger);
            font-weight: 700;
        }

        #confirmarTipoDocumento {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-weight: 800;
        }

        #loadingOverlay .pv-loading-box {
            width: min(92vw, 420px);
            padding: 2rem;
            border-radius: 8px;
            background: white;
            text-align: center;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.28);
        }

        #loadingOverlay .pv-spinner {
            width: 58px;
            height: 58px;
            margin: 0 auto 1rem;
            border: 4px solid #e2e8f0;
            border-top-color: var(--pv-accent);
            border-radius: 50%;
            animation: pvSpin 1s linear infinite;
        }

        @@keyframes pvSpin {
            to { transform: rotate(360deg); }
        }

        @@media (max-width: 1199.98px) {
            .pv-layout {
                grid-template-columns: 1fr;
            }

            .pv-summary {
                position: static;
            }

            .pv-product-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .pv-product-description {
                grid-column: span 2;
            }

            .pv-product-actions {
                grid-column: span 2;
                grid-template-columns: 1fr 1fr;
                align-items: end;
            }
        }

        @@media (max-width: 767.98px) {
            .pv-header,
            .pv-docbar {
                grid-template-columns: 1fr;
                display: grid;
            }

            .pv-status {
                justify-content: center;
                white-space: normal;
            }

            .pv-grid-2,
            .pv-grid-3,
            .pv-product-grid,
            .pv-emisor-grid {
                grid-template-columns: 1fr;
            }

            .pv-product-description,
            .pv-product-actions {
                grid-column: auto;
            }

            .pv-product-actions {
                grid-template-columns: 1fr;
            }

            .pv-cart-item {
                grid-template-columns: 1fr;
            }

            .pv-cart-side {
                grid-template-columns: auto 1fr auto;
                justify-items: start;
                align-items: center;
            }
        }
    </style>
}

@section Scripts {
    <script>
        jQuery(function () {
            var form = jQuery('#puntoVentaForm');
            var tipoDocumento = jQuery('#tipoDocumentoSelect');
            var modalTipoDocumento = jQuery('#modalTipoDocumentoSelect');
            var municipioGuardado = null;
            var documentoModal = null;
            var catalogoModal = null;
            var catalogoSeleccionActual = null;
            var catalogoBusquedaTimer = null;

            // La geografía proviene exclusivamente del catálogo fiscal importado.
            var departamentos = [];

            var paises = [
                { codigo: 'BZ', nombre: 'Belice' }, { codigo: 'CR', nombre: 'Costa Rica' },
                { codigo: 'SV', nombre: 'El Salvador' }, { codigo: 'GT', nombre: 'Guatemala' },
                { codigo: 'HN', nombre: 'Honduras' }, { codigo: 'NI', nombre: 'Nicaragua' },
                { codigo: 'PA', nombre: 'Panama' }, { codigo: 'CA', nombre: 'Canada' },
                { codigo: 'US', nombre: 'Estados Unidos' }, { codigo: 'MX', nombre: 'Mexico' },
                { codigo: 'ES', nombre: 'Espana' }
            ];

            var catalogosServidor = {
                departamentos: @Html.Raw(JsonSerializer.Serialize(Model.CatalogoDepartamentos.Where(x => x.Activo).Select(x => new { codigo = x.Codigo, nombre = x.Descripcion }))),
                municipios: @Html.Raw(JsonSerializer.Serialize(Model.CatalogoMunicipios.Where(x => x.Activo).Select(x => new { codigo = x.Codigo, nombre = x.Descripcion }))),
                distritos: @Html.Raw(JsonSerializer.Serialize(Model.CatalogoDistritos.Where(x => x.Activo).Select(x => new { id = x.Id.ToString(), codigo = x.Codigo, nombre = x.Descripcion }))),
                paises: @Html.Raw(JsonSerializer.Serialize(Model.CatalogoPaises.Select(x => new { codigo = x.Codigo, nombre = x.Descripcion }))),
                donaciones: @Html.Raw(JsonSerializer.Serialize(Model.CatalogoDonaciones.Select(x => new { codigo = x.Codigo, nombre = x.Descripcion })))
            };
            var municipiosCatalogo = catalogosServidor.municipios || [];
            departamentos = catalogosServidor.departamentos || [];
            if (catalogosServidor.paises && catalogosServidor.paises.length) paises = catalogosServidor.paises;

            var catalogosLocales = {
                departamento: departamentos,
                distrito: catalogosServidor.distritos || [],
                pais: paises,
                donacion: catalogosServidor.donaciones && catalogosServidor.donaciones.length ? catalogosServidor.donaciones : [
                    { codigo: '1', nombre: 'Efectivo' },
                    { codigo: '2', nombre: 'Bien' },
                    { codigo: '3', nombre: 'Servicios' }
                ],
                operacion: [
                    { codigo: 'Bien', nombre: 'Bien' },
                    { codigo: 'Servicio', nombre: 'Servicio' }
                ]
            };

            inicializarSelectorCatalogos();
            inicializarModalTipoDocumento();
            actualizarEstadoDocumento();
            restaurarScroll();
            jQuery('#Factura_CodigoProducto').trigger('focus');

            jQuery('#Factura_CantidadProducto, #Factura_PrecioProducto').on('click', function () {
                jQuery(this).select();
            });

            tipoDocumento.on('change', actualizarEstadoDocumento);
            tipoDocumento.on('change', function () {
                modalTipoDocumento.val(jQuery(this).val());
            });
            modalTipoDocumento.on('change', function () {
                jQuery('#modalTipoDocumentoError').hide();
            });
            jQuery('#confirmarTipoDocumento').on('click', confirmarTipoDocumento);
            jQuery('#retencionRentaCheck').on('change', actualizarTotalesVisuales);

            form.on('submit', function (e) {
                var submitter = e.originalEvent && e.originalEvent.submitter ? e.originalEvent.submitter : document.activeElement;
                var handler = submitter ? (submitter.getAttribute('formaction') || '') : '';

                guardarScrollYMunicipio();

                if (handler.indexOf('AgregarProducto') !== -1 && !validarAgregarProducto()) {
                    e.preventDefault();
                    return false;
                }

                if (handler.indexOf('ProcesarFactura') !== -1) {
                    if (!validarProcesarFactura()) {
                        e.preventDefault();
                        return false;
                    }
                    bloquearProcesamiento(jQuery(submitter));
                }
            });

            function inicializarModalTipoDocumento() {
                modalTipoDocumento.val(tipoDocumento.val());

                var modalElement = document.getElementById('tipoDocumentoModal');
                if (!modalElement || typeof bootstrap === 'undefined' || !bootstrap.Modal) return;

                documentoModal = new bootstrap.Modal(modalElement, {
                    backdrop: 'static',
                    keyboard: false
                });

                if (!tipoDocumento.val()) {
                    setTimeout(function () {
                        documentoModal.show();
                        modalTipoDocumento.trigger('focus');
                    }, 180);
                }
            }

            function confirmarTipoDocumento() {
                var valor = modalTipoDocumento.val();

                if (!valor) {
                    jQuery('#modalTipoDocumentoError').show();
                    modalTipoDocumento.trigger('focus');
                    return;
                }

                tipoDocumento.val(valor).trigger('change');

                if (documentoModal) {
                    documentoModal.hide();
                }

                jQuery('#Factura_CodigoProducto').trigger('focus');
            }

            function actualizarEstadoDocumento() {
                var tipoDoc = tipoDocumento.val();
                var estado = jQuery('#estadoDocumento');
                var hayTipo = !!tipoDoc;

                jQuery('#alertaTipoDocumento').toggle(!hayTipo);
                jQuery('.btn-agregar-producto').prop('disabled', !hayTipo);
                jQuery('.iva-row').toggle(tipoDoc === '02');
                jQuery('.campos-credito-fiscal').toggle(tipoDoc === '02' || tipoDoc === '15');
                jQuery('.campo-pais, .campo-tipo-donacion').toggle(tipoDoc === '15');
                jQuery('.campo-sujeto-excluido').toggle(tipoDoc === '14');

                if (tipoDoc !== '15') {
                    jQuery('#Factura_CodigoPais').val('');
                    jQuery('#Factura_CodigoPaisTexto').val('');
                    limpiarCatalogo('#Factura_TipoDonacion', '#Factura_TipoDonacionTexto');
                }

                if (tipoDoc !== '14') {
                    limpiarCatalogo('#Factura_TipoOperacion', '#Factura_TipoOperacionTexto');
                    jQuery('#retencionRentaCheck').prop('checked', false);
                }

                estado.toggleClass('is-ready', hayTipo);
                estado.find('i').attr('class', hayTipo ? 'bi bi-check-circle' : 'bi bi-exclamation-circle');
                estado.find('span').text(hayTipo ? textoTipoDocumento(tipoDoc) : 'Seleccione documento');

                actualizarTotalesVisuales();
            }

            function textoTipoDocumento(tipoDoc) {
                switch (tipoDoc) {
                    case '01': return 'Consumidor Final';
                    case '02': return 'Credito Fiscal';
                    case '14': return 'Sujeto Excluido';
                    case '15': return 'Donacion';
                    default: return 'Documento seleccionado';
                }
            }

            function validarAgregarProducto() {
                var tipoDoc = tipoDocumento.val();
                if (!tipoDoc) {
                    enfocarConMensaje('#tipoDocumentoSelect', 'Seleccione un tipo de documento antes de agregar productos.');
                    return false;
                }

                if (tipoDoc === '15') {
                    if (!jQuery('#Factura_CodigoPais').val()) {
                        enfocarConMensaje('#Factura_CodigoPais', 'Seleccione un codigo de pais para documentos de donacion.');
                        return false;
                    }
                    if (!jQuery('#Factura_TipoDonacion').val()) {
                        enfocarConMensaje('#Factura_TipoDonacion', 'Seleccione un tipo de donacion.');
                        return false;
                    }
                }

                var codigo = jQuery.trim(jQuery('#Factura_CodigoProducto').val());
                var descripcion = jQuery.trim(jQuery('#Factura_DescripcionProducto').val());
                var cantidad = parseFloat(jQuery('#Factura_CantidadProducto').val());
                var precio = parseFloat(jQuery('#Factura_PrecioProducto').val());

                if (!codigo || !descripcion || !cantidad || cantidad <= 0 || !precio || precio <= 0) {
                    enfocarConMensaje('#Factura_CodigoProducto', 'Complete codigo, descripcion, cantidad y precio con valores validos.');
                    return false;
                }

                return true;
            }

            function validarProcesarFactura() {
                if (!tipoDocumento.val()) {
                    enfocarConMensaje('#tipoDocumentoSelect', 'Seleccione el tipo de documento.');
                    return false;
                }
                return true;
            }

            function enfocarConMensaje(selector, mensaje) {
                alert(mensaje);
                jQuery(selector).trigger('focus');
            }

            function actualizarTotalesVisuales() {
                var tipoDoc = tipoDocumento.val();
                var totalExento = 0;
                var totalGravado = 0;
                var iva = tipoDoc === '02' ? totalGravado * 0.13 : 0;
                var retencion = 0;

                jQuery('.pv-cart-item').each(function () {
                    var subtotal = parseFloat(jQuery(this).data('subtotal')) || 0;
                    if (String(jQuery(this).data('exento')) === 'true') {
                        totalExento += subtotal;
                    } else {
                        totalGravado += subtotal;
                    }
                });

                iva = tipoDoc === '02' ? totalGravado * 0.13 : 0;

                if (tipoDoc === '14' && jQuery('#retencionRentaCheck').is(':checked')) {
                    retencion = (totalExento + totalGravado) * 0.10;
                }

                jQuery('#totalExentoValue').text(formatCurrency(totalExento));
                jQuery('#totalGravadoValue').text(formatCurrency(totalGravado));
                jQuery('#ivaValue').text(formatCurrency(iva));
                jQuery('#retencionValue').text('-' + formatCurrency(retencion));
                jQuery('.retencion-row').toggle(retencion > 0);
                jQuery('#totalGeneralValue').text(formatCurrency(totalExento + totalGravado + iva - retencion));
            }

            function formatCurrency(value) {
                return '$' + Number(value || 0).toFixed(2);
            }

            function guardarScrollYMunicipio() {
                sessionStorage.setItem('pvScrollPosition', String(jQuery(window).scrollTop()));
                municipioGuardado = jQuery('#Factura_Receptor_CodigoMunicipio').val();
                if (municipioGuardado) {
                    sessionStorage.setItem('pvMunicipioSeleccionado', municipioGuardado);
                }
            }

            function restaurarScroll() {
                var savedPosition = sessionStorage.getItem('pvScrollPosition');
                if (!savedPosition) return;

                setTimeout(function () {
                    jQuery('html, body').animate({ scrollTop: savedPosition }, 220);
                    sessionStorage.removeItem('pvScrollPosition');
                    jQuery('#Factura_CodigoProducto').trigger('focus');
                }, 120);
            }

            function inicializarSelectorCatalogos() {
                var modalElement = document.getElementById('catalogoBusquedaModal');
                if (modalElement && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    catalogoModal = new bootstrap.Modal(modalElement);
                }

                inicializarTextoCatalogo('Factura_Receptor_CodigoDepartamento', 'Factura_Receptor_CodigoDepartamentoTexto', departamentos);
                inicializarTextoCatalogo('Factura_Receptor_CodigoMunicipio', 'Factura_Receptor_CodigoMunicipioTexto', municipiosCatalogo);
                var distritoId = jQuery('#Factura_Receptor_DistritoId').val();
                var distrito = catalogosLocales.distrito.find(function (item) { return item.id === distritoId; });
                if (distrito) jQuery('#Factura_Receptor_DistritoTexto').val(distrito.codigo + ' - ' + distrito.nombre);
                inicializarTextoCatalogo('Factura_CodigoPais', 'Factura_CodigoPaisTexto', paises);
                inicializarTextoCatalogo('Factura_TipoDonacion', 'Factura_TipoDonacionTexto', catalogosLocales.donacion);
                inicializarTextoCatalogo('Factura_TipoOperacion', 'Factura_TipoOperacionTexto', catalogosLocales.operacion);

                var actividad = jQuery('#Factura_Receptor_CodActividad').val();
                var actividadTexto = jQuery('#Factura_Receptor_DescActividad').val();
                if (actividad) {
                    jQuery('#Factura_Receptor_CodActividadTexto').val(actividadTexto ? actividad + ' - ' + actividadTexto : actividad);
                }

                jQuery(document).on('click', '.btn-buscar-catalogo', abrirModalCatalogo);
                jQuery('#catalogoBusquedaTexto').on('input', function () {
                    clearTimeout(catalogoBusquedaTimer);
                    var termino = jQuery.trim(jQuery(this).val());
                    catalogoBusquedaTimer = setTimeout(function () { cargarResultadosCatalogo(termino); }, 180);
                });
            }

            function inicializarTextoCatalogo(codigoId, textoId, items) {
                var codigo = jQuery('#' + codigoId).val();
                if (!codigo) return;

                var item = jQuery.grep(items || [], function (valor) { return String(valor.codigo) === String(codigo); })[0];
                jQuery('#' + textoId).val(item ? item.codigo + ' - ' + item.nombre : codigo);
            }

            function abrirModalCatalogo() {
                var boton = jQuery(this);
                var tipo = boton.data('catalogo');
                if (tipo === 'municipio' && !jQuery('#Factura_Receptor_CodigoDepartamento').val()) {
                    enfocarConMensaje('#Factura_Receptor_CodigoDepartamentoTexto', 'Seleccione primero el departamento.');
                    return;
                }
                if (tipo === 'distrito' && !jQuery('#Factura_Receptor_CodigoMunicipio').val()) {
                    enfocarConMensaje('#Factura_Receptor_CodigoMunicipioTexto', 'Seleccione primero el municipio fiscal.');
                    return;
                }

                catalogoSeleccionActual = {
                    tipo: tipo,
                    codigoId: boton.data('target-code'),
                    textoId: boton.data('target-text')
                };

                jQuery('#catalogoBusquedaModalLabel').text('Buscar ' + tituloCatalogo(tipo));
                jQuery('#catalogoBusquedaTexto').val('');
                jQuery('#catalogoBusquedaVacio').hide();
                jQuery('#catalogoBusquedaCargando').hide();
                jQuery('#catalogoBusquedaResultados').empty();
                if (catalogoModal) {
                    catalogoModal.show();
                    setTimeout(function () { jQuery('#catalogoBusquedaTexto').trigger('focus'); }, 180);
                }
                cargarResultadosCatalogo('');
            }

            function tituloCatalogo(tipo) {
                return {
                    departamento: 'departamento', municipio: 'municipio', distrito: 'distrito fiscal', pais: 'pais',
                    actividad: 'actividad economica', donacion: 'tipo de donacion', operacion: 'tipo de operacion'
                }[tipo] || 'valor';
            }

            function cargarResultadosCatalogo(termino) {
                if (!catalogoSeleccionActual) return;

                var tipo = catalogoSeleccionActual.tipo;
                if (tipo === 'actividad') {
                    if (!termino) {
                        renderizarResultadosCatalogo([]);
                        return;
                    }

                    jQuery('#catalogoBusquedaCargando').show();
                    jQuery.ajax({
                        url: '/api/CodigoActividadEconomicaApi/buscar',
                        dataType: 'json',
                        data: { term: termino }
                    }).done(function (data) {
                        renderizarResultadosCatalogo(jQuery.map(data || [], function (item) {
                            return { codigo: item.codigo, nombre: item.descripcion || item.textoCompleto, descripcion: item.descripcion };
                        }));
                    }).fail(function () {
                        renderizarResultadosCatalogo([]);
                    }).always(function () {
                        jQuery('#catalogoBusquedaCargando').hide();
                    });
                    return;
                }

                var items = obtenerItemsCatalogo(tipo);
                var filtrados = jQuery.grep(items, function (item) {
                    var texto = (item.codigo + ' ' + item.nombre).toLowerCase();
                    return !termino || texto.indexOf(termino.toLowerCase()) !== -1;
                });
                renderizarResultadosCatalogo(filtrados);
            }

            function obtenerItemsCatalogo(tipo) {
                if (tipo === 'municipio') return municipiosCatalogo;
                return catalogosLocales[tipo] || [];
            }

            function renderizarResultadosCatalogo(items) {
                var resultados = jQuery('#catalogoBusquedaResultados').empty();
                jQuery('#catalogoBusquedaVacio').toggle(!items.length);
                jQuery.each(items.slice(0, 100), function (_, item) {
                    var boton = jQuery('<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"></button>');
                    boton.append(jQuery('<span></span>').text(item.codigo + ' - ' + item.nombre));
                    boton.append(jQuery('<i class="bi bi-chevron-right text-muted"></i>'));
                    boton.on('click', function () { seleccionarCatalogo(item); });
                    resultados.append(boton);
                });
            }

            function seleccionarCatalogo(item) {
                if (!catalogoSeleccionActual) return;
                var actual = catalogoSeleccionActual;
                jQuery('#' + actual.codigoId).val(actual.tipo === 'distrito' ? item.id : item.codigo).trigger('change');
                jQuery('#' + actual.textoId).val(item.codigo + ' - ' + item.nombre);

                if (actual.tipo === 'departamento') {
                    limpiarCatalogo('#Factura_Receptor_CodigoMunicipio', '#Factura_Receptor_CodigoMunicipioTexto');
                    sessionStorage.removeItem('pvMunicipioSeleccionado');
                }
                if (actual.tipo === 'departamento' || actual.tipo === 'municipio') {
                    limpiarCatalogo('#Factura_Receptor_DistritoId', '#Factura_Receptor_DistritoTexto');
                }
                if (actual.tipo === 'actividad') {
                    jQuery('#Factura_Receptor_DescActividad').val(item.descripcion || item.nombre);
                }

                if (catalogoModal) catalogoModal.hide();
            }

            function limpiarCatalogo(codigoSelector, textoSelector) {
                jQuery(codigoSelector).val('').trigger('change');
                jQuery(textoSelector).val('');
            }

            function bloquearProcesamiento(button) {
                if (button.hasClass('processing')) return;

                button.addClass('processing')
                    .prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split"></i><span>Procesando factura...</span>');

                showLoadingOverlay();
            }

            function showLoadingOverlay() {
                if (jQuery('#loadingOverlay').length) {
                    jQuery('#loadingOverlay').show();
                    return;
                }

                jQuery('body').append(
                    '<div id="loadingOverlay" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.68); z-index: 9999; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(3px);">' +
                        '<div class="pv-loading-box">' +
                            '<div class="pv-spinner"></div>' +
                            '<h4><i class="bi bi-gear"></i> Procesando factura</h4>' +
                            '<p class="text-muted mb-2">Generando documento tributario electronico...</p>' +
                            '<p class="text-danger mb-0 font-weight-bold"><i class="bi bi-exclamation-triangle"></i> No cierre esta ventana</p>' +
                        '</div>' +
                    '</div>'
                );
            }
        });
    </script>
}
